# ─────────────────────────────────────────────────────────────────────────────
# GoMatch — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs avant docker compose up
# ─────────────────────────────────────────────────────────────────────────────

# ── SQL Server ────────────────────────────────────────────────────────────────
# Mot de passe fort obligatoire (min 8 chars, majuscule, chiffre, symbole)
SA_PASSWORD=GoMatch@Secure2030!
MSSQL_PID=Developer

# ── JWT ───────────────────────────────────────────────────────────────────────
# Clé secrète partagée entre tous les microservices (min 32 chars)
JWT_KEY=GoMatchSuperSecretJwtKey2030WorldCup!!

# ── Football Data API ─────────────────────────────────────────────────────────
# Clé API football-data.org (gratuite sur https://www.football-data.org/)
FOOTBALL_API_KEY=votre_cle_api_ici

# ── Anthropic (IA) ────────────────────────────────────────────────────────────
# Clé API Anthropic pour le RecoService (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-votre_cle_ici

# Modèle Claude à utiliser (optionnel)
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=350

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Client ID Google pour la connexion Google (optionnel)
GOOGLE_CLIENT_ID=votre_google_client_id.apps.googleusercontent.com
