# Gateway URL (points to your API Gateway)
GATEWAY_BASE_URL=http://localhost:5266

# Anthropic API key — get yours at https://console.anthropic.com
# Without this key the service still works but uses template responses
ANTHROPIC_API_KEY=sk-ant-...

# LLM model (default: claude-haiku-4-5-20251001 — fast & cheap)
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=350

# Service paths (default values match the gateway config)
PROFILE_SERVICE_PATH=/profile
BUSINESS_SERVICE_PATH=/business
MATCH_SERVICE_PATH=/event-matches
DISCOVERY_SERVICE_PATH=/decouverte
